# Copy to .env for local development (`.env` is git-ignored).
# Every variable except DATABASE_URL is optional; values shown are defaults
# unless marked (local).

# --- required --------------------------------------------------------------
# Production: use sslmode=verify-full and a secret store, never a committed file.
DATABASE_URL=postgres://medication:medication@localhost:5432/medication?sslmode=disable

# --- http ------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# Deadline for the work behind one request (503 + Retry-After when it expires);
# must stay below HTTP_WRITE_TIMEOUT.
REQUEST_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=65536
SHUTDOWN_TIMEOUT=20s
# (local) no load balancer to drain; default is 5s
SHUTDOWN_DRAIN_DELAY=0s

# --- database pool -----------------------------------------------------------
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=5s
# (local) apply migrations on start; default false (prod runs `api migrate`)
MIGRATE_ON_START=true

# --- auth ------------------------------------------------------------------
# Comma-separated id:key pairs; keys at least 16 characters. The id is what
# logs show (key_id); the key is never logged. Empty = every /v1 request gets
# 401 (deny by default). Generate keys with: openssl rand -base64 32
# (local) the key below is what requests.http and `make smoke` send.
API_KEYS=local-dev:local-dev-key-change-me

# --- pricing (simulated networks) -------------------------------------------
# Total time budget for the fan-out; must stay below REQUEST_TIMEOUT.
PRICING_BUDGET=300ms

# --- admin (pprof) -----------------------------------------------------------
# Separate listener for /debug/pprof, unauthenticated: bind to loopback or a
# private network only. Empty (default) disables it.
# ADMIN_ADDR=127.0.0.1:6060

# --- logging -----------------------------------------------------------------
LOG_LEVEL=info
